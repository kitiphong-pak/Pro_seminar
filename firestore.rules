rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ผู้ใช้เข้าถึงข้อมูลตัวเองเท่านั้น
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // subcollections ใต้ user (achievements, quiz scores ฯลฯ)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Articles — อ่านได้ทุกคน เขียนได้แค่ admin
    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ปิดกั้นทุกอย่างที่ไม่ได้กำหนด
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
